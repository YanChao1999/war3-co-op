package Results
import ProgressStore
import Config
import Printing
import Unlocks

public class Results
	static function show(bool victory, int outposts, real elapsed)
		print("========== 任务结算 ==========")
		if victory
			print("|cff00ff00胜利 — 最后的要塞屹立不倒。|r")
		else
			print("|cffff0000失败 — 重整旗鼓再战。|r")
		print("用时：" + (elapsed / 60.).toInt().toString() + " 分钟  哨站：" + outposts.toString() + "/3")
		printLine(Config.ARTHAS_ID, ProgressStore.arthasLevel(), ProgressStore.arthasXp)
		printLine(Config.THRALL_ID, ProgressStore.thrallLevel(), ProgressStore.thrallXp)
		printLine(Config.TYRANDE_ID, ProgressStore.tyrandeLevel(), ProgressStore.tyrandeXp)
		printLine(Config.JAINA_ID, ProgressStore.jainaLevel(), ProgressStore.jainaXp)
		printLine(Config.ILLIDAN_ID, ProgressStore.illidanLevel(), ProgressStore.illidanXp)
		printLine(Config.WATCHER_ID, ProgressStore.watcherLevel(), ProgressStore.watcherXp)
		printLine(Config.REXXAR_ID, ProgressStore.rexxarLevel(), ProgressStore.rexxarXp)
		print("|cffffff00存档码：|r " + ProgressStore.currentCode())
		print("下次输入：-load " + ProgressStore.currentCode())
		print("================================")

	static function printLine(string id, int level, int xp)
		print(Config.displayNameZh(id) + " " + level.toString() + "级（经验 " + xp.toString() + "）")
		print("  下一项：" + Unlocks.labelFor(id, level + 1))
