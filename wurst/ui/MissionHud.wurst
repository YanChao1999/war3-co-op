package MissionHud
import EnemyDirector
import Lifecycle
import Config
import CommanderRegistry

/** Multiboard HUD — use natives so 1.27a builds avoid Framehandle.show() clashes. */
public class MissionHud
	static multiboard board = null

	static function create()
		board = CreateMultiboard()
		MultiboardSetTitleText(board, "最后的要塞")
		MultiboardSetRowCount(board, 7)
		MultiboardSetColumnCount(board, 2)
		MultiboardSetItemsStyle(board, true, false)
		MultiboardSetItemsWidth(board, 0.10)
		MultiboardDisplay(board, true)

	static function refresh(real elapsed, int outpostsDestroyed)
		if board == null
			return
		let remainMission = Config.MISSION_DURATION - elapsed
		let remainClamped = remainMission < 0. ? 0. : remainMission
		let nextWave = EnemyDirector.secondsToNextWave(elapsed)

		setCell(0, 0, "剩余时间")
		setCell(0, 1, formatTime(remainClamped))
		setCell(1, 0, "下一波")
		setCell(1, 1, formatTime(nextWave))
		setCell(2, 0, "哨站")
		setCell(2, 1, outpostsDestroyed.toString() + " / 3")
		setCell(3, 0, "状态")
		setCell(3, 1, stateLabel())

		let a = CommanderRegistry.commanderA
		let b = CommanderRegistry.commanderB
		if a != null
			setCell(4, 0, a.displayName)
			setCell(4, 1, a.secondaryResourceName() + ": " + a.secondaryResource.toString())
		if b != null
			setCell(5, 0, b.displayName)
			setCell(5, 1, b.secondaryResourceName() + ": " + b.secondaryResource.toString())
		setCell(6, 0, "提示")
		setCell(6, 1, "-status 查看详情")

	static function setCell(int row, int col, string text)
		let mbItem = MultiboardGetItem(board, row, col)
		MultiboardSetItemValue(mbItem, text)
		MultiboardSetItemStyle(mbItem, true, false)
		MultiboardReleaseItem(mbItem)

	static function formatTime(real seconds) returns string
		let clamped = seconds < 0. ? 0. : seconds
		let s = clamped.toInt()
		let mm = s div 60
		let ss = s mod 60
		if ss < 10
			return mm.toString() + ":0" + ss.toString()
		return mm.toString() + ":" + ss.toString()

	static function stateLabel() returns string
		switch Lifecycle.state
			case MissionState.RUNNING
				return "进行中"
			case MissionState.VICTORY
				return "胜利"
			case MissionState.DEFEAT
				return "失败"
			case MissionState.SELECTING
				return "选择指挥官"
			default
				return "大厅"
