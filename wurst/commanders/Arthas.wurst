package Arthas
import Commander
import Config
import SyncRng
import UnitIds
import Unit
import Vectors
import Angle
import Printing

/** 天灾指挥官 — 复活亡者、灵魂与亡灵大军。 */
public class Arthas extends Commander
	construct(player owner)
		super(owner, Config.ARTHAS_ID, Config.displayNameZh(Config.ARTHAS_ID))

	override function heroUnitId() returns int
		return UnitIds.deathknight

	override function workerUnitId() returns int
		return UnitIds.acolyte

	override function townHallUnitId() returns int
		return UnitIds.necropolis

	override function secondaryResourceName() returns string
		return "灵魂"

	override function onMissionStart()
		setupEconomy(basePos)
		spawnHero(basePos + vec2(64., -64.))
		createUnit(owner, UnitIds.ghoul, basePos + vec2(200., -100.), 270..fromDeg())
		createUnit(owner, UnitIds.ghoul, basePos + vec2(260., -100.), 270..fromDeg())
		if hasUnlock(2)
			createUnit(owner, UnitIds.necromancer, basePos + vec2(180., -160.), 270..fromDeg())
		print("|cff99ff99阿尔萨斯已就绪。|r 指令：-raise / -army（复活 / 亡灵大军）")

	override function onEnemyKilled(unit killed, vec2 where)
		addSecondary(Config.SOULS_PER_KILL)
		if hasUnlock(5) and SyncRng.chance(35)
			createUnit(owner, UnitIds.skeletonwarrior, where, 270..fromDeg())

	override function trySpecialAbility()
		if hasUnlock(5) == false
			print("|cffffcc00复活亡者需指挥官达到 5 级解锁。|r")
			return
		if spendSecondary(Config.RAISE_COST) == false
			print("|cffff5555需要 " + Config.RAISE_COST.toString() + " 灵魂。|r")
			return
		if hero == null or not hero.isAlive()
			return
		let pos = hero.getPos()
		createUnit(owner, UnitIds.ghoul, pos + vec2(100., 0.), 270..fromDeg())
		createUnit(owner, UnitIds.skeletonwarrior, pos + vec2(-100., 0.), 270..fromDeg())
		createUnit(owner, UnitIds.skeletonwarrior, pos + vec2(0., 100.), 270..fromDeg())
		print("|cff99ff99复活亡者！|r 灵魂：" + secondaryResource.toString())

	override function tryUltimate()
		if hasUnlock(10) == false
			print("|cffffcc00亡灵大军需指挥官达到 10 级解锁。|r")
			return
		if spendSecondary(Config.ULTIMATE_COST) == false
			print("|cffff5555需要 " + Config.ULTIMATE_COST.toString() + " 灵魂。|r")
			return
		if hero == null or not hero.isAlive()
			return
		let pos = hero.getPos()
		for i = 0 to 5
			let ang = (i * 60.).fromDeg()
			createUnit(owner, UnitIds.ghoul, pos + vec2(120. * ang.cos(), 120. * ang.sin()), 270..fromDeg())
		createUnit(owner, UnitIds.abomination, pos + vec2(0., -150.), 270..fromDeg())
		if hasUnlock(6)
			createUnit(owner, UnitIds.abomination, pos + vec2(150., -150.), 270..fromDeg())
		print("|cffcc66ff亡灵大军！|r")
