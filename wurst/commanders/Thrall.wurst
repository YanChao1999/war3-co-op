package Thrall
import Commander
import Config
import UnitIds
import Unit
import Vectors
import Angle
import Printing

/** 部落指挥官 — 元素之力与进攻型兽人大军。 */
public class Thrall extends Commander
	construct(player owner)
		super(owner, Config.THRALL_ID, Config.displayNameZh(Config.THRALL_ID))

	override function heroUnitId() returns int
		return UnitIds.thrall

	override function workerUnitId() returns int
		return UnitIds.peon

	override function townHallUnitId() returns int
		return UnitIds.greathall

	override function secondaryResourceName() returns string
		return "灵能"

	override function onMissionStart()
		setupEconomy(basePos)
		spawnHero(basePos + vec2(64., -64.))
		createUnit(owner, UnitIds.grunt, basePos + vec2(200., -100.), 270..fromDeg())
		createUnit(owner, UnitIds.grunt, basePos + vec2(260., -100.), 270..fromDeg())
		if hasUnlock(2)
			createUnit(owner, UnitIds.wolfrider, basePos + vec2(180., -160.), 270..fromDeg())
		print("|cff99ff99萨尔已就绪。|r 指令：-elemental / -storm（召唤元素 / 元素风暴）")

	override function onEnemyKilled(unit killed, vec2 where)
		addSecondary(Config.SPIRIT_PER_KILL)

	override function trySpecialAbility()
		if hasUnlock(5) == false
			print("|cffffcc00召唤元素需指挥官达到 5 级解锁。|r")
			return
		if spendSecondary(Config.ELEMENTAL_COST) == false
			print("|cffff5555需要 " + Config.ELEMENTAL_COST.toString() + " 灵能。|r")
			return
		if hero == null or not hero.isAlive()
			return
		let pos = hero.getPos()
		createUnit(owner, UnitIds.waterelemental2, pos + vec2(80., 0.), 270..fromDeg())
			..setTimedLife(45.)
		print("|cff66ccff元素已召唤！|r 灵能：" + secondaryResource.toString())

	override function tryUltimate()
		if hasUnlock(10) == false
			print("|cffffcc00元素风暴需指挥官达到 10 级解锁。|r")
			return
		if spendSecondary(Config.ULTIMATE_COST) == false
			print("|cffff5555需要 " + Config.ULTIMATE_COST.toString() + " 灵能。|r")
			return
		if hero == null or not hero.isAlive()
			return
		let pos = hero.getPos()
		for i = 0 to 3
			let ang = (i * 90.).fromDeg()
			createUnit(owner, UnitIds.waterelemental3, pos + vec2(160. * ang.cos(), 160. * ang.sin()), 270..fromDeg())
				..setTimedLife(40.)
		if hasUnlock(6)
			createUnit(owner, UnitIds.tauren, pos + vec2(0., -120.), 270..fromDeg())
		print("|cff66ccff元素风暴！|r")
