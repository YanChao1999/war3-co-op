package Jaina
import Commander
import Config
import UnitIds
import Unit
import Vectors
import Angle
import Printing

/** 联盟指挥官 — 奥术能量、法术支援与防御。 */
public class Jaina extends Commander
	construct(player owner)
		super(owner, Config.JAINA_ID, Config.displayNameZh(Config.JAINA_ID))

	override function heroUnitId() returns int
		return UnitIds.jaina

	override function workerUnitId() returns int
		return UnitIds.peasant

	override function townHallUnitId() returns int
		return UnitIds.townhall

	override function secondaryResourceName() returns string
		return "奥术能"

	override function onMissionStart()
		setupEconomy(basePos)
		spawnHero(basePos + vec2(64., -64.))
		createUnit(owner, UnitIds.footman, basePos + vec2(200., -100.), 270..fromDeg())
		createUnit(owner, UnitIds.rifleman, basePos + vec2(260., -100.), 270..fromDeg())
		if hasUnlock(2)
			createUnit(owner, UnitIds.sorceress, basePos + vec2(180., -160.), 270..fromDeg())
		print("|cff99ff99吉安娜已就绪。|r 指令：-arcane / -blizzard（奥术援军 / 暴风雪）")

	override function onEnemyKilled(unit killed, vec2 where)
		addSecondary(Config.ARCANE_PER_KILL)

	override function trySpecialAbility()
		if hasUnlock(5) == false
			print("|cffffcc00奥术援军需指挥官达到 5 级解锁。|r")
			return
		if spendSecondary(Config.ARCANE_COST) == false
			print("|cffff5555需要 " + Config.ARCANE_COST.toString() + " 奥术能。|r")
			return
		if hero == null or not hero.isAlive()
			return
		let pos = hero.getPos()
		createUnit(owner, UnitIds.sorceress, pos + vec2(80., 0.), 270..fromDeg())
			..setTimedLife(40.)
		createUnit(owner, UnitIds.spellbreaker, pos + vec2(-80., 0.), 270..fromDeg())
			..setTimedLife(40.)
		print("|cff66aaff奥术援军已抵达！|r 奥术能：" + secondaryResource.toString())

	override function tryUltimate()
		if hasUnlock(10) == false
			print("|cffffcc00暴风雪需指挥官达到 10 级解锁。|r")
			return
		if spendSecondary(Config.ULTIMATE_COST) == false
			print("|cffff5555需要 " + Config.ULTIMATE_COST.toString() + " 奥术能。|r")
			return
		if hero == null or not hero.isAlive()
			return
		let pos = hero.getPos()
		for i = 0 to 3
			let ang = (i * 90.).fromDeg()
			createUnit(owner, UnitIds.waterelemental3, pos + vec2(150. * ang.cos(), 150. * ang.sin()), 270..fromDeg())
				..setTimedLife(35.)
		createUnit(owner, UnitIds.rifleman, pos + vec2(100., -100.), 270..fromDeg())
			..setTimedLife(35.)
		createUnit(owner, UnitIds.rifleman, pos + vec2(-100., -100.), 270..fromDeg())
			..setTimedLife(35.)
		if hasUnlock(6)
			createUnit(owner, UnitIds.spellbreaker, pos + vec2(0., -140.), 270..fromDeg())
				..setTimedLife(35.)
		print("|cff66ccff暴风雪！奥术洪流席卷战场！|r")
