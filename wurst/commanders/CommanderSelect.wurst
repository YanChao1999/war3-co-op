package CommanderSelect
import Config
import CoopPlayer
import CommanderRegistry
import ProgressStore
import Lifecycle
import Player
import Trigger
import Printing
import LastFortress
import ClosureTimers

/**
	大厅选择（聊天）：
	-pick arthas|thrall|tyrande|jaina 或中文名
	-load W3C-... / W3C4-...
*/
public class CommanderSelect
	static var pickA = ""
	static var pickB = ""
	static var started = false
	static LastFortress mission = null

	static function startLobby()
		Lifecycle.setState(MissionState.SELECTING)
		print("|cffffff00要塞联防 — 最后的要塞|r（1.27a）")
		print("选择：-pick arthas/thrall/tyrande/jaina/illidan/watcher/rexxar")
		print("中文：阿尔萨斯/萨尔/泰兰德/吉安娜/伊利丹/守望者/雷克萨（不可重复）")
		print("进度：-load W3C7-...    单人：-autostart（另一槽可改电脑）")
		registerChat()
		fillComputerPicks()
		doPeriodically(1.) (_) ->
			if started
				return
			fillComputerPicks()
			if pickA != "" and pickB != "" and pickA != pickB
				tryStart()

	static function registerChat()
		for i = 0 to 11
			let p = players[i]
			CreateTrigger()
				..registerPlayerChatEvent(p, "-", false)
				..addAction(() -> onChat())

	static function onChat()
		let p = GetTriggerPlayer()
		// Keep original case for Chinese names; only lower english commands.
		let raw = GetEventPlayerChatString()
		let msg = StringCase(raw, false)
		if SubString(msg, 0, 5) == "-load"
			handleLoad(p, raw)
			return
		if msg == "-autostart"
			handleAutostart(p)
			return
		if msg == "-status"
			printStatus(p)
			return
		if msg == "-raise" or msg == "-army" or msg == "-elemental" or msg == "-storm" or msg == "-ambush" or msg == "-lunar" or msg == "-arcane" or msg == "-blizzard" or msg == "-consume" or msg == "-meta" or msg == "-blink" or msg == "-avatar" or msg == "-revive" or msg == "-beasts"
			handleAbilityChat(p, msg)
			return
		if SubString(msg, 0, 5) == "-pick"
			handlePick(p, raw)

	static function handleLoad(player p, string msg)
		let saveCode = trimStart(SubString(msg, 5, StringLength(msg)))
		if ProgressStore.applySaveCode(saveCode)
			print("|cff00ff00进度已载入。|r 阿" + ProgressStore.arthasLevel().toString() +
				" | 萨" + ProgressStore.thrallLevel().toString() +
				" | 泰" + ProgressStore.tyrandeLevel().toString() +
				" | 吉" + ProgressStore.jainaLevel().toString() +
				" | 伊" + ProgressStore.illidanLevel().toString() +
				" | 守" + ProgressStore.watcherLevel().toString() +
				" | 雷" + ProgressStore.rexxarLevel().toString())
		else
			print("|cffff5555存档码无效。|r")

	static function handlePick(player p, string msg)
		if started
			return
		if CoopPlayer.isCommanderSlot(p) == false
			print("仅指挥官槽位 1–2 可选择。")
			return
		let id = Config.normalizePick(trimStart(SubString(msg, 5, StringLength(msg))))
		if id == ""
			print("用法：-pick .../rexxar（或中文名，含雷克萨）")
			return
		if p.getId() == Config.COMMANDER_SLOT_A
			pickA = id
		else
			pickB = id
		print(GetPlayerName(p) + " 选择了 " + Config.displayNameZh(id) + "（" + id + "）")
		tryStart()

	static function handleAutostart(player p)
		if started
			return
		if pickA == "" and p.getId() == Config.COMMANDER_SLOT_A
			pickA = Config.ARTHAS_ID
		if pickB == "" and p.getId() == Config.COMMANDER_SLOT_B
			pickB = Config.THRALL_ID
		fillComputerPicks()
		if pickA != "" and pickB == ""
			pickB = CommanderRegistry.otherCommanderId(pickA)
			print("自动为槽位2分配：" + Config.displayNameZh(pickB))
		if pickB != "" and pickA == ""
			pickA = CommanderRegistry.otherCommanderId(pickB)
			print("自动为槽位1分配：" + Config.displayNameZh(pickA))
		tryStart()

	/** Lobby computer on commander slots cannot chat — auto-pick for them. */
	static function fillComputerPicks()
		let a = players[Config.COMMANDER_SLOT_A]
		let b = players[Config.COMMANDER_SLOT_B]
		if GetPlayerController(a) == MAP_CONTROL_COMPUTER and pickA == ""
			pickA = Config.ARTHAS_ID
			print("电脑槽位1 → " + Config.displayNameZh(pickA))
		if GetPlayerController(b) == MAP_CONTROL_COMPUTER and pickB == ""
			if pickA == Config.THRALL_ID
				pickB = Config.ARTHAS_ID
			else
				pickB = Config.THRALL_ID
			print("电脑槽位2 → " + Config.displayNameZh(pickB))

	static function tryStart()
		if started
			return
		if pickA == "" or pickB == ""
			return
		if pickA == pickB
			print("|cffff5555指挥官不可重复，请重新选择。|r")
			return
		CommanderRegistry.assign(Config.COMMANDER_SLOT_A, pickA)
		CommanderRegistry.assign(Config.COMMANDER_SLOT_B, pickB)
		if CommanderRegistry.uniqueCommanders() == false
			print("|cffff5555指挥官分配失败。|r")
			return
		started = true
		mission = new LastFortress()
		mission.initialize()
		doPeriodically(0.5) (_) ->
			if mission != null and Lifecycle.isRunning()
				mission.update(0.5)

	static function handleAbilityChat(player p, string msg)
		let c = CommanderRegistry.forPlayer(p)
		if c == null
			return
		if msg == "-raise" or msg == "-elemental" or msg == "-ambush" or msg == "-arcane" or msg == "-consume" or msg == "-blink" or msg == "-revive"
			c.trySpecialAbility()
		else if msg == "-army" or msg == "-storm" or msg == "-lunar" or msg == "-blizzard" or msg == "-meta" or msg == "-avatar" or msg == "-beasts"
			c.tryUltimate()

	static function printStatus(player p)
		let c = CommanderRegistry.forPlayer(p)
		if c == null
			print("尚未选择指挥官。使用 -pick ...（含 illidan/watcher）")
			return
		print(c.displayName + " " + c.level.toString() + "级 | " + c.secondaryResourceName() + "：" + c.secondaryResource.toString())
		print("存档：" + ProgressStore.currentCode())

	static function trimStart(string s) returns string
		var i = 0
		while i < StringLength(s) and SubString(s, i, i + 1) == " "
			i++
		return SubString(s, i, StringLength(s))
